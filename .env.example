# Private key of a dedicated wallet holding a little USDC on Base.
# Use a dedicated wallet with a small balance — never a main wallet.
# Only needed for PAID tools (brief, event-risk, resource). Free tools
# (catalog, sample) work without it.
AGENT_PRIVATE_KEY=0x...

# Spend cap per single paid call, in US dollars. The x402 client refuses
# any payment above this amount. Default 0.05 covers brief ($0.01) and
# event-risk ($0.05). The dearest resource (analyst-pack) is $2.00.
MAX_USD_PER_CALL=0.05

# Optional: OpenAI key for examples/agent.ts only.
OPENAI_API_KEY=
